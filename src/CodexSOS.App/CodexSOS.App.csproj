<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CodexSOS</AssemblyName>
    <RootNamespace>CodexSOS.App</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <UseSystemDrawing>false</UseSystemDrawing>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Version>0.1.4</Version>
    <Product>Codex SOS</Product>
    <Company>Codex SOS community contributors</Company>
    <Description>Windows-first local helper for Codex troubleshooting.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\codex-sos.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexSOS.Core\CodexSOS.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TesserNet" Version="0.8.0" />
  </ItemGroup>
</Project>
